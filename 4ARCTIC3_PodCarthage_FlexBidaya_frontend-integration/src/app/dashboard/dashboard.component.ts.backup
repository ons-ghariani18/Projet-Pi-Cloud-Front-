import { Component, OnInit, AfterViewChecked, OnDestroy, HostListener, ViewChild, ElementRef } from '@angular/core';
import { Router } from '@angular/router';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { ForumService, ForumPost, ForumComment } from '../services/forum.service';
import { UserService } from '../services/user.service';
import { ReactionService } from '../services/reaction.service';
import { FriendshipService, Friendship, UserSummary } from '../services/friendship.service';
import { MessagingService, MessageDTO } from '../services/messaging.service';

@Component({
  selector: 'app-dashboard',
  templateUrl: './dashboard.component.html',
  styleUrls: ['./dashboard.component.css']
})
export class DashboardComponent implements OnInit, AfterViewChecked, OnDestroy {
  @ViewChild('messagesContainer') messagesContainer?: ElementRef;

  posts: ForumPost[] = [];
  newPostContent: string = '';
  loading: boolean = false;
  currentUser: any = null;
  searchQuery: string = '';
  searchResults: any[] = [];
  showSearchResults: boolean = false;
  isSearchPopupOpen: boolean = false;
  newCommentContent: { [key: number]: string } = {}; // Pour stocker les commentaires en cours
  editingPostId: number | null = null;
  editingPostContent: { [key: number]: { titre: string; contenu: string } } = {};
  editingCommentId: number | null = null;
  editingCommentContent: { [key: number]: string } = {};
  replyContent: { [key: number]: string } = {};
  showPostMenu: number | null = null;
  showCommentMenu: number | null = null;
  showReplyForm: number | null = null;
  showSearchPopup: boolean = false; // Ajout de la propriété manquante

  currentView: 'feed' | 'friends' | 'invitations' | 'messages' = 'feed';

  constructor(
    private forumService: ForumService,
    private userService: UserService,
    private router: Router,
    private reactionService: ReactionService,
    private friendshipService: FriendshipService,
    private messagingService: MessagingService
  ) {}

  friends: UserSummary[] = [];
  receivedRequests: Friendship[] = [];
  friendError: string = '';
  invitationError: string = '';
  selectedFriend: UserSummary | null = null;
  messages: MessageDTO[] = [];
  newMessage: string = '';
  messagesError: string = '';
  unreadCount: number = 0;

  ngOnInit(): void {
    this.loadCurrentUser();
    this.loadPosts();
    this.loadUnreadMessageCount();
  }

  ngAfterViewChecked(): void {
    this.scrollMessagesToBottom();
  }

  ngOnDestroy(): void {
    // Cleanup if needed
  }

  loadCurrentUser(): void {
    const token = localStorage.getItem('token');
    if (token) {
      this.userService.getCurrentUser().subscribe({
        next: (user) => {
          // Charger le profil complet (incluant profileImage)
          this.userService.getMyProfile().subscribe({
            next: (profile) => {
              this.currentUser = { ...user, ...profile };
            },
            error: () => {
              // Fallback au minimum (username)
              this.currentUser = { ...user, profileImage: '' };
            }
          });
        },
        error: () => {
          this.router.navigate(['/signin']);
        }
      });
    } else {
      this.router.navigate(['/signin']);
    }
  }

  loadPosts(): void {
    this.loadPostsWithReactions();
  }

  // Charger les posts avec les réactions
  private loadPostsWithReactions(): void {
    this.loading = true;
    this.forumService.getPosts().subscribe({
      next: (posts) => {
        this.posts = posts.map(post => ({
          ...post,
          userReaction: null, // Sera mis à jour par l'appel API
          comments: undefined, // Sera chargé à la demande
          showComments: false // Caché par défaut
        }));
        
        // Charger les réactions seulement si l'utilisateur est bien authentifié
        if (this.checkAuthentication()) {
          posts.forEach(post => {
            this.reactionService.getMyPostReaction(post.id).subscribe({
              next: (reaction) => {
                const postIndex = this.posts.findIndex(p => p.id === post.id);
                if (postIndex !== -1) {
                  this.posts[postIndex].userReaction = reaction ? reaction.type : null;
                }
              },
              error: (error) => {
                console.error('Error loading user reaction:', error);
              }
            });
          });
        }
        
        this.loading = false;
      },
      error: (error) => {
        console.error('Error loading posts:', error);
        this.loading = false;
      }
    });
  }

  createPost(): void {
    if (!this.newPostContent.trim()) return;

    this.forumService.createPost({
      titre: 'Nouvelle publication',
      contenu: this.newPostContent
    }).subscribe({
      next: (post) => {
        this.posts.unshift(post);
        this.newPostContent = '';
      },
      error: (error) => {
        console.error('Error creating post:', error);
      }
    });
  }

  likePost(postId: number): void {
    this.forumService.likePost(postId).subscribe({
      next: () => {
        const post = this.posts.find(p => p.id === postId);
        if (post) {
          post.likeCount++;
        }
      },
      error: (error) => {
        console.error('Error liking post:', error);
      }
    });
  }

  reactToPost(postId: number, event: MouseEvent): void {
    const post = this.posts.find(p => p.id === postId);
    if (post && post.userReaction) {
      // Si l'utilisateur a déjà réagi, supprimer la réaction
      this.removeReaction(postId);
    } else {
      // Sinon, afficher le menu de réactions au survol
      this.showReactionMenu(postId, event);
    }
  }

  onMouseEnterReaction(postId: number, event: MouseEvent): void {
    const post = this.posts.find(p => p.id === postId);
    if (!post || post.userReaction) {
      // Afficher le menu seulement si pas de réaction existante
      this.showReactionMenu(postId, event);
    }
  }

  onMouseLeaveReaction(): void {
    this.hideReactionMenu();
  }

  private removeReaction(postId: number): void {
    const post = this.posts.find(p => p.id === postId);
    if (post && post.userReaction) {
      this.reactionService.reactToPost(postId, post.userReaction).subscribe({
        next: (response) => {
          if (response === null) {
            // Réaction supprimée avec succès
            const postIndex = this.posts.findIndex(p => p.id === postId);
            if (postIndex !== -1) {
              this.posts[postIndex].userReaction = null;
              this.posts[postIndex].likeCount--;
            }
          }
        },
        error: (error) => {
          console.error('Error removing reaction:', error);
        }
      });
    }
  }

  private showReactionMenu(postId: number, event: MouseEvent): void {
    // Cacher les menus existants
    this.hideReactionMenu();

    const menu = document.createElement('div');
    menu.className = 'reaction-menu horizontal';
    menu.innerHTML = `
      <div class="reaction-item" data-type="LIKE" data-post-id="${postId}">👍</div>
      <div class="reaction-item" data-type="LOVE" data-post-id="${postId}">❤️</div>
      <div class="reaction-item" data-type="HAHA" data-post-id="${postId}">😂</div>
      <div class="reaction-item" data-type="WOW" data-post-id="${postId}">😮</div>
      <div class="reaction-item" data-type="SAD" data-post-id="${postId}">😢</div>
      <div class="reaction-item" data-type="ANGRY" data-post-id="${postId}">😠</div>
    `;

    // Forcer le style inline pour éviter les conflits CSS
    menu.style.display = 'flex';
    menu.style.flexDirection = 'row';
    menu.style.gap = '4px';
    menu.style.flexWrap = 'nowrap';
    menu.style.whiteSpace = 'nowrap';

    // Positionner le menu horizontalement
    const rect = (event.target as HTMLElement).getBoundingClientRect();
    menu.style.position = 'absolute';
    menu.style.left = rect.left + 'px';
    menu.style.top = (rect.bottom + 5) + 'px';
    menu.style.zIndex = '1000';
    menu.style.minWidth = '300px'; // Assurer assez de place pour horizontal

    document.body.appendChild(menu);

    // Gérer le clic sur une réaction
    menu.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      const type = target.getAttribute('data-type');
      const targetPostIdStr = target.getAttribute('data-post-id');
      
      if (type && targetPostIdStr) {
        const targetPostId = parseInt(targetPostIdStr);
        this.reactionService.reactToPost(targetPostId, type).subscribe({
          next: () => {
            this.updatePostReaction(targetPostId, type);
            this.hideReactionMenu(); // Cacher le menu après sélection
          },
          error: (error) => {
            console.error('Error reacting to post:', error);
          }
        });
      }
    });

    // Ajouter un gestionnaire pour fermer le menu en cliquant ailleurs
    setTimeout(() => {
      const closeMenuHandler = (e: MouseEvent) => {
        const clickedElement = e.target as HTMLElement;
        if (!menu.contains(clickedElement)) {
          document.body.removeChild(menu);
          document.removeEventListener('click', closeMenuHandler);
        }
      };
      document.addEventListener('click', closeMenuHandler);
    }, 100);
  }

  // Cacher le menu de réactions
  private hideReactionMenu(): void {
    const existingMenu = document.querySelector('.reaction-menu');
    if (existingMenu) {
      document.body.removeChild(existingMenu);
    }
  }

  private updatePostReaction(postId: number, newType: string): void {
    const post = this.posts.find(p => p.id === postId);
    if (post) {
      if (post.userReaction) {
        // L'utilisateur avait déjà réagi, juste changer le type
        post.userReaction = newType;
      } else {
        // Nouvelle réaction
        post.userReaction = newType;
        post.likeCount++;
      }
    }
  }

  logout(): void {
    this.userService.logout().subscribe({
      next: () => {
        localStorage.removeItem('token');
        this.router.navigate(['/signin']);
      },
      error: (error) => {
        console.error('Error logging out:', error);
        localStorage.removeItem('token');
        this.router.navigate(['/signin']);
      }
    });
  }

  goToProfile(): void {
    this.router.navigate(['/profile']);
  }

  goToFriends(): void {
    this.viewFriends();
  }

  goToMessages(): void {
    this.currentView = 'messages';
    this.selectedFriend = null;
    this.messages = [];
    this.newMessage = '';
    this.messagesError = '';
    this.friendError = '';
    this.loadFriendsForMessages();
  }

  searchUsers(): void {
    this.isSearchPopupOpen = true;
  }

  viewFriends(): void {
    this.currentView = 'friends';
    this.friendError = '';
    this.loadFriends();
  }

  viewInvitations(): void {
    this.currentView = 'invitations';
    this.invitationError = '';
    this.loadReceivedRequests();
  }

  private loadFriends(): void {
    if (!this.checkAuthentication()) {
      this.router.navigate(['/signin']);
      return;
    }
    this.friendshipService.getFriends().subscribe({
      next: (friends: UserSummary[]) => {
        this.friends = friends;
        if (!friends.length) {
          this.friendError = 'Vous n’avez pas encore d’amis.';
        }
      },
      error: (error: any) => {
        console.error('Error loading friends:', error);
        this.friendError = 'Impossible de charger la liste des amis.';
      }
    });
  }

  private loadFriendsForMessages(): void {
    if (!this.checkAuthentication()) {
      this.router.navigate(['/signin']);
      return;
    }
    this.friendshipService.getFriends().subscribe({
      next: (friends: UserSummary[]) => {
        this.friends = friends;
        if (!friends.length) {
          this.friendError = 'Vous n’avez pas encore d’amis pour chatter.';
        }
      },
      error: (error: any) => {
        console.error('Error loading friends for messages:', error);
        this.friendError = 'Impossible de charger la liste des amis.';
      }
    });
  }
  selectFriend(friend: UserSummary): void {
    this.selectedFriend = friend;
    this.messages = [];
    this.newMessage = '';
    this.messagesError = '';
    // TODO: Load conversation history with this friend
    this.loadConversation(friend.id);
  }

  private loadConversation(friendId: number): void {
    this.messagingService.getConversation(friendId).subscribe({
      next: (messages) => {
        this.messages = messages;
        this.scrollMessagesToBottom();
        this.loadUnreadMessageCount();
      },
      error: (error) => {
        console.error('Error loading conversation:', error);
        this.messagesError = 'Erreur lors du chargement de la conversation';
        this.messages = [];
      }
    });
  }

  sendMessage(): void {
    if (!this.newMessage.trim() || !this.selectedFriend) return;

    const content = this.newMessage.trim();
    this.newMessage = '';

    this.messagingService.sendMessage(this.selectedFriend.id, content).subscribe({
      next: (message) => {
        // Add the message to the local conversation
        this.messages.push(message);
        this.scrollMessagesToBottom();
        this.loadUnreadMessageCount();
      },
      error: (error) => {
        console.error('Error sending message:', error);
        this.messagesError = 'Erreur lors de l\'envoi du message';
      }
    });
  }

  backToFriendsList(): void {
    this.selectedFriend = null;
    this.messages = [];
    this.newMessage = '';
    this.messagesError = '';
  }

  private loadUnreadMessageCount(): void {
    this.messagingService.getUnreadMessageCount().subscribe({
      next: (response) => {
        this.unreadCount = response.unreadCount;
      },
      error: (error) => {
        console.error('Error loading unread count:', error);
      }
    });
  }

  private scrollMessagesToBottom(): void {
    if (this.messagesContainer?.nativeElement) {
      const container = this.messagesContainer.nativeElement as HTMLElement;
      container.scrollTop = container.scrollHeight;
    }
  }
  private loadReceivedRequests(): void {
    if (!this.checkAuthentication()) {
      this.router.navigate(['/signin']);
      return;
    }
    this.friendshipService.getReceivedRequests().subscribe({
      next: (requests: Friendship[]) => {
        this.receivedRequests = requests;
        if (!requests.length) {
          this.invitationError = 'Aucune invitation reçue pour le moment.';
        }
      },
      error: (error: any) => {
        console.error('Error loading invitations:', error);
        this.invitationError = 'Impossible de charger les invitations.';
      }
    });
  }

  acceptInvitation(friendshipId: number): void {
    this.friendshipService.acceptRequest(friendshipId).subscribe({
      next: () => {
        this.receivedRequests = this.receivedRequests.filter(req => req.id !== friendshipId);
        this.loadFriends();
      },
      error: (error) => {
        console.error('Error accepting invitation:', error);
        this.invitationError = 'Impossible d’accepter l’invitation.';
      }
    });
  }

  rejectInvitation(friendshipId: number): void {
    this.friendshipService.rejectRequest(friendshipId).subscribe({
      next: () => {
        this.receivedRequests = this.receivedRequests.filter(req => req.id !== friendshipId);
      },
      error: (error) => {
        console.error('Error rejecting invitation:', error);
        this.invitationError = 'Impossible de refuser l’invitation.';
      }
    });
  }
      case 'WOW': return '😮';
      case 'SAD': return '😢';
      case 'ANGRY': return '😠';
      default: return '👍';
    }
  }

  // Obtenir le texte pour le compteur de réactions
  getReactionCount(postId: number, userReaction: string | null | undefined): string {
    if (userReaction) {
      return '1'; // L'utilisateur a réagi, donc on montre 1
    }
    const post = this.posts.find(p => p.id === postId);
    return post ? post.likeCount.toString() : '0'; // Sinon on montre le nombre de likes
  }

  // Ouvrir les commentaires
  openComments(postId: number): void {
    const post = this.posts.find(p => p.id === postId);
    if (!post) return;

    // Basculer l'affichage des commentaires
    post.showComments = !post.showComments;

    // Si on ouvre les commentaires et qu'ils ne sont pas chargés
    if (post.showComments && !post.comments) {
      this.loadComments(postId);
    }
  }

  // Charger les commentaires d'un post
  private loadComments(postId: number): void {
    this.forumService.getPostComments(postId).subscribe({
      next: (comments) => {
        const post = this.posts.find(p => p.id === postId);
        if (post) {
          post.comments = comments;
        }
      },
      error: (error) => {
        console.error('Error loading comments:', error);
      }
    });
  }

  // Ajouter un commentaire
  addComment(postId: number, content: string): void {
    if (!content.trim()) return;

    this.forumService.addComment(postId, content).subscribe({
      next: (comment) => {
        const post = this.posts.find(p => p.id === postId);
        if (post) {
          if (!post.comments) {
            post.comments = [];
          }
          post.comments.unshift(comment);
        }
        // Vider le champ de commentaire
        this.newCommentContent[postId] = '';
      },
      error: (error) => {
        console.error('Error adding comment:', error);
      }
    });
  }

  // Partager un post
  sharePost(postId: number): void {
    const post = this.posts.find(p => p.id === postId);
    if (post) {
      // Créer le menu de partage
      this.showShareMenu(postId, post);
    }
  }

  // Afficher le menu de partage
  private showShareMenu(postId: number, post: any): void {
    // Cacher les menus existants
    this.hideReactionMenu();

    const menu = document.createElement('div');
    menu.className = 'share-menu';
    menu.innerHTML = `
      <div class="share-option" data-action="profile" data-post-id="${postId}">
        <span class="share-icon">👤</span>
        <span class="share-text">Partager sur mon profil</span>
      </div>
      <div class="share-option" data-action="copy" data-post-id="${postId}">
        <span class="share-icon">📋</span>
        <span class="share-text">Copier le lien</span>
      </div>
      <div class="share-option" data-action="external" data-post-id="${postId}">
        <span class="share-icon">🌐</span>
        <span class="share-text">Partager externe</span>
      </div>
    `;

    // Positionner le menu
    const event = window.event as MouseEvent;
    const rect = (event.target as HTMLElement).getBoundingClientRect();
    menu.style.position = 'absolute';
    menu.style.left = rect.left + 'px';
    menu.style.top = (rect.bottom + 5) + 'px';
    menu.style.zIndex = '1000';

    document.body.appendChild(menu);

    // Gérer le clic sur une option de partage
    menu.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      const action = target.getAttribute('data-action');
      const targetPostIdStr = target.getAttribute('data-post-id');
      
      if (action && targetPostIdStr) {
        const targetPostId = parseInt(targetPostIdStr);
        this.handleShareAction(action, targetPostId, post);
      }
      
      document.body.removeChild(menu);
    });

    // Ne pas fermer automatiquement - laisser l'utilisateur choisir
    // Le menu restera visible jusqu'à ce que l'utilisateur choisisse une réaction
    // ou clique ailleurs dans le document
  }

  // Gérer l'action de partage
  private handleShareAction(action: string, postId: number, post: any): void {
    switch (action) {
      case 'profile':
        this.shareToProfile(postId, post);
        break;
      case 'copy':
        this.copyPostLink(postId);
        break;
      case 'external':
        this.shareExternally(postId, post);
        break;
    }
  }

  // Partager sur le profil
  private shareToProfile(postId: number, post: any): void {
    // TODO: Implémenter le partage vers le profil
    console.log('Partage sur le profil du post:', postId);
    alert('Partage sur le profil bientôt disponible !');
  }

  // Copier le lien
  private copyPostLink(postId: number): void {
    const shareUrl = `${window.location.origin}/posts/${postId}`;
    navigator.clipboard.writeText(shareUrl).then(() => {
      alert('Lien de publication copié dans le presse-papiers !');
    });
  }

  // Partager externe
  private shareExternally(postId: number, post: any): void {
    const shareUrl = `${window.location.origin}/posts/${postId}`;
    
    if (navigator.share) {
      navigator.share({
        title: post.titre,
        text: post.contenu,
        url: shareUrl
      });
    } else {
      this.copyPostLink(postId);
    }
  }

  // Méthodes pour l'édition des posts
  startEditingPost(postId: number): void {
    const post = this.posts.find(p => p.id === postId);
    if (post) {
      this.editingPostId = postId;
      this.editingPostContent[postId] = {
        titre: post.titre,
        contenu: post.contenu
      };
    }
  }

  cancelEditingPost(): void {
    this.editingPostId = null;
    this.editingPostContent = {};
  }

  savePost(postId: number): void {
    const content = this.editingPostContent[postId];
    if (content && content.titre.trim() && content.contenu.trim()) {
      this.forumService.updatePost(postId, content.titre, content.contenu).subscribe({
        next: (updatedPost) => {
          const postIndex = this.posts.findIndex(p => p.id === postId);
          if (postIndex !== -1) {
            this.posts[postIndex] = updatedPost;
          }
          this.cancelEditingPost();
        },
        error: (error) => {
          console.error('Error updating post:', error);
          alert('Erreur lors de la mise à jour de la publication');
        }
      });
    }
  }

  deletePost(postId: number): void {
    // Vérifier l'authentification avant de supprimer
    if (!this.checkAuthentication()) {
      this.router.navigate(['/signin']);
      return;
    }
    
    if (confirm('Êtes-vous sûr de vouloir supprimer cette publication ?')) {
      this.forumService.deletePost(postId).subscribe({
        next: () => {
          // Supprimer le post de la liste
          this.posts = this.posts.filter(post => post.id !== postId);
          console.log('Post supprimé avec succès');
        },
        error: (error) => {
          console.error('Error deleting post:', error);
          if (error.status === 401) {
            alert('Erreur d\'authentification : Veuillez vous reconnecter');
            // Rediriger vers la page de connexion
            this.router.navigate(['/signin']);
          } else if (error.status === 403) {
            alert('Erreur de permission : Vous n\'êtes pas autorisé à supprimer cette publication');
          } else {
            alert('Erreur lors de la suppression de la publication');
          }
        }
      });
    }
  }

  // Méthodes pour l'édition des commentaires
  startEditingComment(commentId: number, currentContent: string): void {
    this.editingCommentId = commentId;
    this.editingCommentContent[commentId] = currentContent;
  }

  cancelEditingComment(): void {
    this.editingCommentId = null;
    this.editingCommentContent = {};
  }

  saveComment(commentId: number): void {
    const content = this.editingCommentContent[commentId];
    if (content && content.trim()) {
      this.forumService.updateComment(commentId, content).subscribe({
        next: (updatedComment) => {
          // Mettre à jour le commentaire dans tous les posts
          this.posts.forEach(post => {
            if (post.comments) {
              const commentIndex = post.comments.findIndex(c => c.id === commentId);
              if (commentIndex !== -1) {
                post.comments[commentIndex] = updatedComment;
              }
            }
          });
          this.cancelEditingComment();
        },
        error: (error) => {
          console.error('Error updating comment:', error);
          alert('Erreur lors de la mise à jour du commentaire');
        }
      });
    }
  }

  // Méthode pour répondre à un commentaire
  replyToComment(parentCommentId: number): void {
    const content: string = this.replyContent[parentCommentId];
    if (!content || !content.trim()) {
      alert('Veuillez écrire une réponse');
      return;
    }

    if (!this.forumService) {
      console.error('ForumService not available');
      return;
    }

    this.forumService.replyToComment(parentCommentId, content).subscribe({
      next: (reply: ForumComment) => {
        // Ajouter la réponse aux commentaires du post approprié
        this.posts.forEach((post: ForumPost) => {
          if (post.comments) {
            // Vérifier si le commentaire parent existe dans ce post
            const parentComment = post.comments.find((c: ForumComment) => c.id === parentCommentId);
            if (parentComment) {
              // Ajouter la nouvelle réponse avec le bon parentCommentId
              const newReply = {
                ...reply,
                parentCommentId: parentCommentId
              };
              post.comments.push(newReply);
            }
          }
        });

        // Réinitialiser le formulaire et fermer la popup
        this.replyContent[parentCommentId] = '';
        this.showReplyForm = null;

        console.log('Réponse ajoutée avec succès:', reply);
      },
      error: (error: any) => {
        console.error('Error replying to comment:', error);
        alert('Erreur lors de la réponse au commentaire');
      }
    });
  }

  // Vérifier si l'utilisateur est le propriétaire du post
  isPostOwner(post: ForumPost): boolean {
    const isOwner = this.currentUser && post.username === this.currentUser.username;
    const isAdmin = this.currentUser && this.currentUser.role === 'ADMIN';
    const canEdit = isOwner || isAdmin;
    
    console.log('isPostOwner check:', {
      currentUser: this.currentUser?.username,
      currentUserRole: this.currentUser?.role,
      postUsername: post.username,
      isOwner: isOwner,
      isAdmin: isAdmin,
      canEdit: canEdit
    });
    return canEdit;
  }

  // Vérifier si l'utilisateur est le propriétaire du commentaire
  isCommentOwner(comment: ForumComment): boolean {
    const isOwner = this.currentUser && comment.username === this.currentUser.username;
    const isAdmin = this.currentUser && this.currentUser.role === 'ADMIN';
    const canEdit = isOwner || isAdmin;
    
    console.log('isCommentOwner check:', {
      currentUser: this.currentUser?.username,
      currentUserRole: this.currentUser?.role,
      commentUsername: comment.username,
      isOwner: isOwner,
      isAdmin: isAdmin,
      canEdit: canEdit
    });
    return canEdit;
  }

  // Méthodes pour gérer les menus dropdown
  togglePostMenu(postId: number): void {
    this.showPostMenu = this.showPostMenu === postId ? null : postId;
    this.showCommentMenu = null; // Fermer l'autre menu
  }

  toggleCommentMenu(commentId: number): void {
    this.showCommentMenu = this.showCommentMenu === commentId ? null : commentId;
    this.showPostMenu = null; // Fermer l'autre menu
  }

  // Méthodes pour gérer les formulaires de réponse
  toggleReplyForm(commentId: number): void {
    this.showReplyForm = this.showReplyForm === commentId ? null : commentId;
  }

  cancelReply(commentId: number): void {
    this.replyContent[commentId] = '';
    this.showReplyForm = null;
  }

  // Méthodes pour les réactions aux commentaires
  likeComment(commentId: number): void {
    this.forumService.likeComment(commentId).subscribe({
      next: () => {
        // Mettre à jour le compteur de likes dans tous les posts
        this.posts.forEach(post => {
          if (post.comments) {
            const comment = post.comments.find(c => c.id === commentId);
            if (comment) {
              comment.likeCount = (comment.likeCount || 0) + 1;
            }
          }
        });
      },
      error: (error) => {
        console.error('Error liking comment:', error);
      }
    });
  }

  // Méthode pour supprimer un commentaire
  deleteComment(commentId: number): void {
    // Vérifier l'authentification avant de supprimer
    if (!this.checkAuthentication()) {
      this.router.navigate(['/signin']);
      return;
    }
    
    if (confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?')) {
      this.forumService.deleteComment(commentId).subscribe({
        next: () => {
          // Supprimer le commentaire de tous les posts
          this.posts.forEach(post => {
            if (post.comments) {
              post.comments = post.comments.filter(c => c.id !== commentId);
            }
          });
          console.log('Commentaire supprimé avec succès');
        },
        error: (error) => {
          console.error('Error deleting comment:', error);
          if (error.status === 401) {
            alert('Erreur d\'authentification : Veuillez vous reconnecter');
            // Rediriger vers la page de connexion
            this.router.navigate(['/signin']);
          } else if (error.status === 403) {
            alert('Erreur de permission : Vous n\'êtes pas autorisé à supprimer ce commentaire');
          } else {
            alert('Erreur lors de la suppression du commentaire');
          }
        }
      });
    }
  }

  // Fermer tous les menus quand on clique ailleurs
  @HostListener('document:click', ['$event'])
  onDocumentClick(event: Event): void {
    const target = event.target as HTMLElement;
    if (!target.closest('.post-actions-menu') && !target.closest('.comment-actions-menu')) {
      this.showPostMenu = null;
      this.showCommentMenu = null;
    }
    
    // Fermer la popup de réponse en cliquant sur le fond
    if (target.classList.contains('reply-form')) {
      this.showReplyForm = null;
    }
  }

  // Fermer la popup de réponse avec la touche Escape
  @HostListener('keydown.escape')
  onEscapeKey(): void {
    this.showReplyForm = null;
  }

  // Vérifier l'état de l'authentification
  checkAuthentication(): boolean {
    const token = localStorage.getItem('token');
    if (!token) {
      console.warn('Aucun token trouvé dans localStorage');
      return false;
    }
    
    try {
      // Décoder le token pour vérifier s'il est expiré
      const payload = JSON.parse(atob(token.split('.')[1]));
      const now = Date.now() / 1000;
      
      if (payload.exp < now) {
        console.warn('Token expiré');
        localStorage.removeItem('token');
        return false;
      }
      
      return true;
    } catch (error) {
      console.error('Erreur lors du décodage du token:', error);
      localStorage.removeItem('token');
      return false;
    }
  }

  // Rafraîchir l'authentification si nécessaire
  ensureAuthenticated(): void {
    if (!this.checkAuthentication()) {
      alert('Votre session a expiré. Veuillez vous reconnecter.');
      this.router.navigate(['/signin']);
    }
  }
}
